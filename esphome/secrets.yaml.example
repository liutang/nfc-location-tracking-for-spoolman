# Add these to ESPHome's secrets.yaml (Device Builder: Secrets, top right).
wifi_ssid: "your-wifi-name"
wifi_password: "your-wifi-password"
# Shared by every reader for the Home Assistant API and OTA updates.
# Generate one with: openssl rand -base64 32
spool_reader_api_key: "paste-the-generated-key-here"
